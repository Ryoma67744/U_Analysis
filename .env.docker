# =============================================================================
# MSI Analysis Application - Docker デプロイ用環境変数テンプレート
#
# 使用方法:
#   1. このファイルを .env にコピー: cp .env.docker .env
#   2. 下記 4 つの認証関連変数を必ず設定
#   3. docker compose up -d --build で起動
#   4. 起動後すぐにブラウザでログイン → パスワード変更 UI で
#      INITIAL_PASSWORD_A/B から本番パスワードに更新
# =============================================================================

# =============================================================================
# 【重要】認証設定 (Tier A / Tier B / Master)
#
# - Tier A (Password A): プロジェクト一覧のフル機能。解析者用。
# - Tier B (Password B): 共有 URL (/share/<token>) の閲覧専用。
# - Master Password: A/B 変更時に要求。サーバー管理者のみが知るべき。
#
# A/B のパスワードはアプリ内 UI から自由に変更可能で、
# Data/Other/common/auth.json に bcrypt ハッシュで保存される。
# 下記 INITIAL_PASSWORD_A/B は初回起動時のみ参照される。
#
# 生成例:
#   FLASK_SECRET_KEY: openssl rand -hex 32
#   MASTER_PASSWORD:  openssl rand -base64 24
# =============================================================================

# Flask セッション暗号鍵 (必須・32 バイト以上の random)
FLASK_SECRET_KEY=CHANGE_ME_TO_RANDOM_HEX_64

# Master Password (A/B 変更時に要求。漏らさない)
MASTER_PASSWORD=CHANGE_ME_MASTER_PASSWORD

# 初回起動時のみ使用 (auth.json 生成後は参照されない)
# 起動後すぐに UI で別パスワードに変更すること
INITIAL_PASSWORD_A=ChangeMe_A_FirstRun
INITIAL_PASSWORD_B=ChangeMe_B_FirstRun

# HTTPS (Caddy 等のリバプロ) 経由ならセッション Cookie を Secure 属性付与
# SESSION_COOKIE_SECURE=true

# セッション Cookie の有効期間（秒）
# デフォルト: 86400 (1 日)
# 過去のデフォルト 30 日は Session 固定攻撃のリスクが大きいため短縮しました。
# 利用シナリオに応じて調整: 短時間 (4 時間 = 14400) / 長期 (7 日 = 604800)
SESSION_COOKIE_MAX_AGE_SEC=86400

# R subprocess 実行の wallclock timeout (秒)。0 で無効化 (Docker mem_limit に委ねる)。
# 巨大データ + OOM で 1 ユーザーがリソース占有し全体停止する事故を防止。
#
# 【重要】短すぎると解析が正常に進行していても途中で強制終了される。
#   実測: 10万px 級 (約 14 万 spot x 2000 特徴量) の再解析は Harmony/UMAP/クラスタリング/
#   マーカー検出/RPCA まで通すと 約 2 時間 を要する。1200 (20 分) では全く足りない。
#   超過時は解析ログに [TIMEOUT] 行が出る。
#
# 推奨:
#   - まず 0 (無効) で運用し、実際の所要時間を測る。物理的な暴走は mem_limit が抑える。
#   - 制限を掛けるなら実測時間の 2 倍以上。10万px 級なら 21600 (6 時間) 程度。
R_ANALYSIS_TIMEOUT_SEC=0

# R 内部メモリ上限 (GB)。0 / 未設定で制限なし。R が指定上限を超えた時点で
# 安全に終了 (vector memory limit of N Gb reached) し、システム OOM を回避。
#
# 【重要】低すぎる値を入れると大規模解析が「開始直後」に落ちる。
#   10万px 超のデータは Parquet 読込〜PCA だけで数 GB を要し、Harmony/UMAP/RPCA では
#   さらに増える。mem_limit に対して大幅に低い値は事実上「解析を禁止する」設定になる。
#
# 推奨:
#   - まず 0 (制限なし) で運用する。物理上限は Docker の mem_limit + memswap_limit が担保する。
#   - 無言 OOM kill (R のエラー無しでログが途切れる) の切り分けが必要なときだけ、
#     mem_limit の 9 割程度を設定する。docker-compose.yml の既定 mem_limit=12g なら 11。
R_MAX_VSIZE_GB=0

# Step3 RPCA(IntegrateLayers) の実行可否。1/未設定=実行、0=スキップ。
# RPCA は「技術的バッチ」の補正用で、Harmony/無補正PCA の結果だけで足りる場面も多い。
# 大規模データ + 低い mem_limit で Step3 が OOM 停止する場合に 0 にすると、Harmony/PCA まで
# 完走して正常終了する（R 側 ENABLE_RPCA を上書き）。
RUN_RPCA=1

# --- 再解析(クラスタ除外→再UMAP)の検証用オプション ---
# 10万px 級の再解析は 2 時間超かかるため、Step3(RPCA) だけを試したいときに
# Step1/Step2 をやり直さずに再開できる。
#
# 使い方:
#   1) 再開元にしたい実行の「前に」 SAVE_STEP2_WITH_COUNTS=1 を設定して回す
#      （RPCA は counts 層を読むため、既定の Step2 RDS では再開できない）
#   2) その実行の RDS_Files のパスを REUMAP_RESUME_DIR に指定して再実行する
#      例: REUMAP_RESUME_DIR=/app/Data/TIMS/Data/<PROJECT>/<OUT>/RDS_Files
#   3) 検証が済んだら両方とも空/0 に戻す
#
# 注: 再開時も Parquet エクスポートは実行される。これは無駄ではなく、オーケストレータ側の
#     メモリ状態を通常実行と揃え、RPCA 直前の条件を忠実に再現するため。
REUMAP_RESUME_DIR=
SAVE_STEP2_WITH_COUNTS=0

# Step1 RDS の保存可否。0 でスキップ（完走時の出力は不変だが中断時の再開ができなくなる）。
SAVE_STEP1_RDS=1

# DEG(FindAllMarkers) の並列ワーカー数。未設定なら残メモリから自動決定。0/1 で逐次実行。
# multisession は各ワーカーへ解析オブジェクトを複製するため、残メモリが乏しいと OOM する。
DEG_WORKERS=

# 取り込み時の 1 ブロックあたり予算(MB)。未設定なら 256。小さくすると分割数が増える。
INGEST_BLOCK_MB=

# qs 保存のスレッド数。未設定なら detectCores-1。ネイティブ側の切り分け時は 1 にする。
QS_NTHREADS=

# _project_states (interactive callbacks のプロジェクト別状態キャッシュ) の上限。
# 別プロジェクトを次々開く操作で蓄積するメモリリーク対策。
# デフォルト 8 件 / 30 分 TTL。小サーバなら 4 / 600 等に縮小推奨。
MAX_PROJECT_STATES=8
PROJECT_STATE_TTL_SEC=1800

# アプリケーション設定
APP_PORT=3838
APP_HOST=0.0.0.0

# R 実行環境（Docker 内では変更不要）
R_HOME=/usr/lib/R

# 共有リンク用ベースURL
# ドメインを取得した場合に設定（例: https://msi.example.com）
SHARE_BASE_URL=

# =============================================================================
# ChatGPT 連携 API (受付窓口 /api/gpt/*)  — ver41.0
# =============================================================================
# GPT_API_KEY: ChatGPT (Custom GPT の Action) から /api/gpt/* を呼ぶための合言葉。
#   - サーバ側だけに保持する秘密。ChatGPT 側の Action 設定に「API Key 認証
#     (ヘッダ名 X-API-Key)」として登録する。OpenAPI 仕様書や URL には出さない。
#   - 未設定 (空) の間は /api/gpt/* が 503 を返し、窓口は開かない (fail-closed)。
#   - 生成例: openssl rand -hex 32
# GPT_API_KEY=CHANGE_ME_TO_RANDOM_HEX_64

# =============================================================================
# 抽出キャッシュの保持数  — ver53.0
# =============================================================================
# SEURAT_CACHE_MAX_ENTRIES: 抽出キャッシュ (Seurat RDS を展開したもの) を
#   いくつ保持するか。超えると mtime の古いものから物理削除される。
#   - クラスタ統計 / 化合物検索 / 発現量の取得はこのキャッシュを使う。
#     消えると次に使うとき数分の再抽出が要る (warmup またはアプリで開く)。
#   - **サブプロジェクトの総数より大きくしておくと、暖め直しが不要になる。**
#     総数は「プロジェクト一覧の n_sub_projects の合計」で分かる。
#   - 1 件あたりのサイズはデータ規模による。実測してから決めること:
#       docker compose exec msi-app du -sh /app/Data/Other/seurat_cache
#       docker compose exec msi-app du -sh /app/Data/Other/seurat_cache/* | sort -h | tail -3
# SEURAT_CACHE_MAX_ENTRIES=30

# =============================================================================
# 大容量データのホストマウント（さくらVPS 推奨配置）
# =============================================================================
# 未設定の場合は Docker named volume (msi-desi-data / msi-tims-data / msi-output)
# に保存。数百 GB 以上の生データや、SFTP でアプリ外部から書き込みたい場合は、
# ホスト上の固定パスをマウントする。
#
# 推奨ディレクトリ構成（詳細は App/docs/DATA_LAYOUT.md 参照）:
#   /srv/msi/
#     ├── desi_data/   ← DESI 生データ（SFTPアップロード先）
#     ├── tims_data/   ← TIMS 生データ（SFTPアップロード先）
#     └── output/      ← 解析出力（アプリが書き込み・SFTPでダウンロード）
#
# 事前準備（VPS で一度だけ実行）:
#   sudo mkdir -p /srv/msi/{desi_data,tims_data,output}
#   sudo groupadd msi-lab
#   sudo chown -R :msi-lab /srv/msi && sudo chmod -R 2775 /srv/msi
#
# 下記コメントを外して有効化:
# DESI_DATA_HOST=/srv/msi/desi_data
# TIMS_DATA_HOST=/srv/msi/tims_data
# OUTPUT_DATA_HOST=/srv/msi/output
#
# アプリ(コンテナ)が参加する共有グループの GID。SFTP 共有グループ msi-lab の GID に合わせる。
# 確認: getent group msi-lab （多くの環境で 1001）。docker-compose.yml の group_add が参照し、
# 未設定なら 1001 が既定値。GID が異なる場合のみ下記を有効化して設定する。
# MSI_SHARED_GID=1001

# =============================================================================
# UI ロック設定（複数ユーザー同時編集時の排他制御）
# =============================================================================
# EDIT_LOCK_TIMEOUT_SEC: 編集ロックの自動解放までの秒数（heartbeat で延長される）
#   短い (10-30s): 離席後すぐ他ユーザーが取れる、編集中の取りこぼし注意
#   長い (60-300s): ゆったり編集可能、離席後の待ち時間長い
# EDIT_LOCK_HEARTBEAT_INTERVAL_SEC: ブラウザがサーバへ heartbeat する間隔
#   通常 TIMEOUT の 1/3 を推奨 (10s/30s, 30s/90s, 60s/300s 等)
EDIT_LOCK_TIMEOUT_SEC=30
EDIT_LOCK_HEARTBEAT_INTERVAL_SEC=10
