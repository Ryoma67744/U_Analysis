# =============================================================================
# MSI Analysis Application - Docker デプロイ用環境変数テンプレート
#
# 使用方法:
#   1. このファイルを .env にコピー: cp .env.docker .env
#   2. APP_PASSWORD を設定
#   3. docker compose up -d --build で起動
# =============================================================================

# =============================================================================
# 【重要】APP_PASSWORD は必ず設定してください
#   未設定（空欄）のままだと HTTP Basic Auth が無効化され、
#   誰でも本アプリにアクセス可能になります（社内 LAN 越しでも危険）。
#   下記のプレースホルダーを実際のパスワードに置き換えてください。
# =============================================================================
APP_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# アプリケーション設定
APP_PORT=3838
APP_HOST=0.0.0.0

# R 実行環境（Docker 内では変更不要）
R_HOME=/usr/lib/R

# 共有リンク用ベースURL
# ドメインを取得した場合に設定（例: https://msi.example.com）
SHARE_BASE_URL=

# =============================================================================
# 大容量データのホストマウント（任意）
# =============================================================================
# 未設定の場合は Docker named volume (msi-desi-data / msi-tims-data) に保存。
# 数百 GB 以上の生データを扱う場合は、ホスト上の固定パスをマウント推奨
# （named volume は docker 内のディスクを消費するため）。
#
# 例（コメントを外して実環境のパスに書き換える）:
# DESI_DATA_HOST=/mnt/desi_data
# TIMS_DATA_HOST=/mnt/tims_data
