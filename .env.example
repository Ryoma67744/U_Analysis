# =============================================================================
# MSI Analysis Application — 環境設定
# このファイルを .env にコピーして環境に合わせて編集してください
# =============================================================================

# R実行環境のパス
R_HOME=C:\Program Files\R\R-4.4.2

# アプリケーション設定
APP_PORT=3838
APP_HOST=0.0.0.0

# 共有URL生成用ベースURL
# 空の場合: LAN IPを自動検出（LAN内共有用）
# Cloudflare Tunnel使用時:
#   1. cloudflared をインストール
#   2. Quick Tunnel: cloudflared tunnel --url http://localhost:3838
#   3. 表示されたURLをここに設定
SHARE_BASE_URL=
