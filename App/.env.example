# =============================================================================
# MSI Analysis Application — 環境設定
# このファイルを .env にコピーして環境に合わせて編集してください
# =============================================================================

# R実行環境のパス
R_HOME=C:\Program Files\R\R-4.4.2

# アプリケーション設定
APP_PORT=3838
APP_HOST=0.0.0.0

# =============================================================================
# 認証設定 (Tier A / Tier B / Master)
# - Tier A (Password A): プロジェクト一覧フル機能
# - Tier B (Password B): /share/<token> 閲覧専用
# - Master Password: A/B 変更権限 (.env のみ。UI 変更不可)
# A/B のパスワードはアプリ内 UI から変更可能で、
# Data/Other/common/auth.json に bcrypt 保存される。
# 生成例: FLASK_SECRET_KEY → openssl rand -hex 32
#         MASTER_PASSWORD   → openssl rand -base64 24
# =============================================================================
FLASK_SECRET_KEY=CHANGE_ME_TO_RANDOM_HEX_64
MASTER_PASSWORD=CHANGE_ME_MASTER_PASSWORD
INITIAL_PASSWORD_A=ChangeMe_A_FirstRun
INITIAL_PASSWORD_B=ChangeMe_B_FirstRun
# SESSION_COOKIE_SECURE=true  # HTTPS 経由なら有効化

# 認証情報 (auth.json) の保存先。通常は設定不要。
# 既定は Data/Other/common/auth.json（Docker では /app/Data/Other/common/auth.json
# となり msi-common ボリュームに保存される。ver56.3 以前は この絶対パスが
# 決め打ちで、Docker を使わない起動では書き込めず起動不能だった）。
# 別ボリュームに置きたい場合や、複数インスタンスで分けたい場合のみ指定する。
# AUTH_CONFIG_PATH=/path/to/auth.json

# 共有URL生成用ベースURL（受信者がアクセスする公開アドレス）
# 空の場合: アクセス元ホスト(request.host)から自動生成。リバースプロキシ(Caddy 等)
#           経由なら X-Forwarded-Proto を見て https を判定する。
#           ※Docker 単体起動など request 文脈外ではコンテナ内部 IP になり外部到達
#             不可なので、本番では下記のように明示設定を推奨。
# 例(本番 IP 直): SHARE_BASE_URL=https://133.167.73.188
# 例(ドメイン)  : SHARE_BASE_URL=https://msi.example.com
# 例(Cloudflare Tunnel): cloudflared tunnel --url http://localhost:3838 で出た URL
# ※ver52.6 以降、この値は共有リンクだけでなく ChatGPT 連携 API が名乗る
#   OpenAPI の servers URL にも使われる（両者の出どころを 1 つに揃えた）。
SHARE_BASE_URL=

# =============================================================================
# ChatGPT 連携 API (/api/gpt/*)
# =============================================================================
# GPT_API_KEY: ChatGPT (Custom GPT の Action) から /api/gpt/* を呼ぶための合言葉。
#   - サーバ側だけに保持する秘密。ChatGPT 側の Action 設定に「API Key 認証
#     (ヘッダ名 X-API-Key)」として登録する。OpenAPI 仕様書や URL には出さない。
#   - 未設定 (空) の間は /api/gpt/* が 503 を返し、窓口は開かない (fail-closed)。
#     ※死活確認の /api/gpt/health だけは鍵不要で 200 を返す。「health は通るのに
#       他が全部 503」なら、この値が未設定。
#   - 生成例: openssl rand -hex 32
#   - 設定手順とつながらないときの切り分けは App/docs/CHATGPT_API_SETUP.md 参照。
GPT_API_KEY=

# =============================================================================
# 生データ格納先 (任意・解析者ごとに自由に設定)
# =============================================================================
# 重い生データをリポジトリ外の固定パスに置き、アプリ更新後も再コピー不要に
# します。設定しない場合は同梱の Data/DESI/Data, Data/TIMS/Data を参照します。
#
# 過去プロジェクトの復活手順:
#   1. 下記の DESI_DATA_DIR / TIMS_DATA_DIR に生データを配置
#   2. アプリ起動 → サイドバー「プロジェクト復元」でスキャン
#   3. projects.json の絶対パスが自動補正され過去プロジェクトが復活
#
# DESI_DATA_DIR=/Users/your-name/MSI_Data/DESI
# TIMS_DATA_DIR=/Users/your-name/MSI_Data/TIMS
