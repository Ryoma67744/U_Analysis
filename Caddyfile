# =============================================================================
# MSI Analysis Application - Caddy リバースプロキシ設定
#
# ドメイン名を取得後、下記の "msi.example.com" を実際のドメインに置換してください。
# Caddy が Let's Encrypt から自動でSSL証明書を取得します。
#
# IP アドレスでの直接アクセス（HTTPのみ）の場合:
#   :80 {
#       reverse_proxy msi-app:3838
#   }
# =============================================================================

msi.example.com {
    reverse_proxy msi-app:3838
}
