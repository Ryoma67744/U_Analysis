# =============================================================================
# MSI Analysis Application - Caddy リバースプロキシ設定
#
# 【手順】
#  1. 独自ドメインを取得し、A レコードを VPS の IP アドレスに向ける
#     （詳細: App/docs/DEPLOY.md セクション 7.1〜7.2）
#  2. 下記の "msi.example.com" を実際のドメインに置換:
#       sed -i 's/msi\.example\.com/msi.yourlab.com/g' Caddyfile
#  3. 本番構成で起動:
#       docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Caddy が Let's Encrypt から SSL 証明書を自動取得・自動更新します。
# 取得には TCP 80 / 443 が外部から到達可能である必要があります。
#
# 【ドメインを取らず IP アドレス直アクセス（HTTPのみ・非推奨）の場合】
#   下記ブロックを削除し、代わりに以下を記述:
#     :80 {
#         reverse_proxy msi-app:3838
#     }
#   ※ パスワードが平文で流れるためチーム共有運用には不向き
# =============================================================================

{
    # ドメイン未取得のため、Caddy のローカル CA で自己署名証明書を発行。
    # ブラウザでは初回警告 → 「詳細→進む」で利用可。
    auto_https disable_redirects
}

# IP 直アクセス用: ポート 443 で待ち受け、自己署名証明書を提示
:443 {
    tls internal

    reverse_proxy msi-app:3838 {
        transport http {
            read_timeout 600s
            write_timeout 600s
            dial_timeout 30s
        }
        # X-Forwarded-Proto を渡し、Flask 側で secure Cookie / HTTPS 判別を可能に
        header_up X-Forwarded-Proto https
    }

    request_body {
        max_size 500MB
    }

    # セキュリティヘッダー (clickjacking / sniff / referrer)
    # 自己署名運用では HSTS を有効化しない（ドメイン取得後の切替で詰むため）
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Cache-Control "no-store"
    }

    log {
        output stdout
        format json
    }
}

# HTTP は明示的に HTTPS へリダイレクト（auto_https を無効化したので手動で定義）
:80 {
    redir https://{host}{uri} 308
}
