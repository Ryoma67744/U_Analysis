# =============================================================================
# MSI Analysis Application - Caddy リバースプロキシ設定
#
# 現状: ドメイン未取得のため IP アドレス直アクセス + Caddy ローカル CA で
#       自己署名証明書を発行する構成 (本番暫定)。
#
# 構成は Caddy 公式の最小パターン:
#   https://caddyserver.com/docs/automatic-https
#   "192.168.1.10 { tls internal; ... }" 形式
# auto_https は **デフォルトのまま (有効)** にする。これにより:
#   - :443 リスナーが自動生成され、tls internal で内部 CA leaf が発行される
#   - :80 → :443 への 308 リダイレクトも自動で構成される
#
# 将来ドメインを取得したら:
#   1. 133.167.73.188 → msi.yourlab.com に置換
#   2. tls internal の行を削除 (Let's Encrypt 自動取得に戻る)
#   3. （任意）Strict-Transport-Security ヘッダを復活させ HSTS 有効化
# =============================================================================

{
	# TLS handshake / 証明書発行の詳細をログに出す（原因切り分け用）。
	# 問題が解決したらこの行を削除して通常運用に戻すこと。
	debug
}

# Site address に IP を指定。スキーム省略 (':443' でも 'https://' でもなく)
# が公式推奨。Caddy が IP として認識し、内部 CA で leaf を発行する。
133.167.73.188 {
	tls internal

	reverse_proxy msi-app:3838 {
		transport http {
			read_timeout 600s
			write_timeout 600s
			dial_timeout 30s
		}
		# X-Forwarded-Proto を渡し、Flask 側で secure Cookie / HTTPS 判別を可能に
		header_up X-Forwarded-Proto https
	}

	request_body {
		max_size 500MB
	}

	# セキュリティヘッダー (clickjacking / sniff / referrer)
	# 自己署名運用では HSTS は有効化しない（ドメイン切替時に詰むため）
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cache-Control "no-store"
	}

	# Caddy アクセスログ (json) を stdout に。docker logs で確認可能。
	log {
		output stdout
		format json
	}
}
