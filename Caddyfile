# =============================================================================
# MSI Analysis Application - Caddy リバースプロキシ設定
#
# 現状: ドメイン未取得のため IP アドレス直アクセス + Caddy ローカル CA で
#       自己署名証明書を発行する構成 (本番暫定)。
# 将来ドメインを取得したら:
#   1. {auto_https off} のグローバル設定を削除
#   2. https://133.167.73.188 → msi.yourlab.com に置換
#   3. tls internal の行を削除（Let's Encrypt 自動取得に戻る）
#   4. （任意）Strict-Transport-Security ヘッダを復活させ HSTS 有効化
# =============================================================================

{
    # 自動 HTTPS (ACME) を完全に無効化。tls internal で内部 CA を使う。
    # disable_redirects ではなく off にしないと、IP 用の TLS connection policy が
    # 適切に生成されず TLSv1.3 internal error (alert 80) が発生する
    # (caddyserver/caddy #6364)。
    auto_https off
}

# Site address に IP+スキームを明示する。:443 portless ブロックは SNI を
# 要求するため、IP 接続 (SNI 未送信) で internal error になる
# (caddyserver/caddy #6784)。
https://133.167.73.188 {
    tls internal

    reverse_proxy msi-app:3838 {
        transport http {
            read_timeout 600s
            write_timeout 600s
            dial_timeout 30s
        }
        # X-Forwarded-Proto を渡し、Flask 側で secure Cookie / HTTPS 判別を可能に
        header_up X-Forwarded-Proto https
    }

    request_body {
        max_size 500MB
    }

    # セキュリティヘッダー (clickjacking / sniff / referrer)
    # 自己署名運用では HSTS は有効化しない（ドメイン切替時に詰むため）
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # /healthz は cache 不要、その他は SPA なので no-store でも OK
        Cache-Control "no-store"
    }

    # Caddy アクセスログ (json) を stdout に。docker logs で確認可能。
    log {
        output stdout
        format json
    }
}

# HTTP は HTTPS に 308 リダイレクト (auto_https off なので手動定義が必須)
http://133.167.73.188 {
    redir https://{host}{uri} 308
}
