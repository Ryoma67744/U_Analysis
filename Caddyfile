# =============================================================================
# MSI Analysis Application - Caddy リバースプロキシ設定
#
# ドメイン取得済み: cciiumap.duckdns.org (DuckDNS 無料サブドメイン) → 133.167.73.188
# Caddy が Let's Encrypt から正規の TLS 証明書を自動取得・自動更新する。
#   - :443 リスナー + :80 → :443 リダイレクトを auto_https が自動構成
#   - 証明書取得には 80/443 が外部から到達可能である必要がある
#     (さくらのパケットフィルタで HTTP:80 / HTTPS:443 を開放済み)
#
# 旧構成 (IP 直アクセス + tls internal 自己署名) に戻す場合は git 履歴の旧版を参照。
# =============================================================================

{
	# SNI (接続先ホスト名) を送らないクライアントへのフォールバック。
	# ChatGPT (Custom GPT の Action) など一部の API フェッチャは空 SNI で TLS 接続してくる。
	# これが無いと Caddy は "no certificate matching TLS ClientHello" で握手を拒否し、
	# ブラウザでは開けるのに ChatGPT からは接続できない (アクセスログにも残らない) 事象になる。
	# 空 SNI の相手にはドメイン証明書を既定で提示する。
	default_sni cciiumap.duckdns.org

	# TLS handshake / 証明書発行の詳細をログに出す (初回発行の切り分け用)。
	# 正規証明書の取得が安定したらこの行を削除して通常運用に戻すこと。
	debug

	# Let's Encrypt の有効期限通知などを受け取るメール (任意・推奨)。
	# email you@example.com
}

# Site address にドメインを指定。スキームを省略すると Caddy が自動的に
# HTTPS 化し、Let's Encrypt から証明書を取得する (tls ディレクティブ不要)。
cciiumap.duckdns.org {
	reverse_proxy msi-app:3838 {
		transport http {
			read_timeout 600s
			write_timeout 600s
			dial_timeout 30s
		}
		# X-Forwarded-Proto を渡し、Flask 側で secure Cookie / HTTPS 判別を可能に
		header_up X-Forwarded-Proto https
	}

	request_body {
		max_size 500MB
	}

	# -------------------------------------------------------------------------
	# 応答の圧縮 (ver46.1)
	# -------------------------------------------------------------------------
	# Dash のコールバック応答 (/_dash-update-component) は Plotly の figure JSON
	# であり、座標や色の数値が延々と並ぶため 8〜12 倍に圧縮される。これまで
	# 圧縮指定が無く、数 MB〜数十 MB がそのまま流れていた（画像切替・パンが重い
	# 主要因のひとつ）。Caddy は Accept-Encoding を見て自動で選択する。
	encode zstd gzip

	# セキュリティヘッダー (clickjacking / sniff / referrer)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# 正規ドメイン + 正規 TLS になったので HSTS を有効化してよい (任意)。
		# 有効化するとブラウザが以後 HTTPS を強制する (切替直後は慎重に)。
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Cache-Control は「静的アセット」と「それ以外」で分ける (ver46.1)。
	# 従来は全応答に no-store を付けていたため、Dash/Plotly の JS バンドル
	# (plotly.js だけで約 3.5MB) をページを開くたび再ダウンロードしていた。
	# 両者は排他のマッチャにしてある。同じ header ディレクティブを重ねると
	# 後勝ちで上書きされるため、matcher を重複させないこと。
	@static path /_dash-component-suites/* /assets/* /_favicon.ico
	@dynamic not path /_dash-component-suites/* /assets/* /_favicon.ico
	# 内容ハッシュ付き URL で配信されるので長期キャッシュしてよい。
	header @static Cache-Control "public, max-age=31536000, immutable"
	# 認証付きアプリのため、HTML とコールバック応答は従来どおりキャッシュ禁止。
	header @dynamic Cache-Control "no-store"

	# Caddy アクセスログ (json) を stdout に。docker logs で確認可能。
	log {
		output stdout
		format json
	}
}
