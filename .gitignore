# ユーザデータ (Data/ 配下は永続領域)
Data/DESI/Data/*
!Data/DESI/Data/.gitkeep
Data/TIMS/Data/*
!Data/TIMS/Data/.gitkeep
Data/Other/Common/*
!Data/Other/Common/.gitkeep
Data/Other/sessions/*
!Data/Other/sessions/.gitkeep
Data/Other/shares/*
!Data/Other/shares/.gitkeep
Data/Other/cache/*
!Data/Other/cache/.gitkeep
Data/Other/logs/*
!Data/Other/logs/.gitkeep
Data/Other/output/*
!Data/Other/output/.gitkeep
# projects/ と presets/ は JSON 実体ファイルを追跡 (バックアップ/履歴は下で除外)
Data/Other/projects/backups/
Analysis_*/

# 大容量DBファイル（GitHub 100MB制限）
App/DB/TIMS/260228-hmdb_metabolites_charge_aware_merged_with_list.csv

# Python キャッシュ
__pycache__/
*.pyc

# 一時ファイル
*.tmp.*
app_output.log
nul

# 環境設定（機密情報を含む可能性あり）
.env
# env_file_manager / filelock が実行時に生成するロックファイル（一時物）
.env.lock
*.env.lock

# Python 仮想環境
.venv/
venv/

# Rセッション（レガシー、リポジトリルート直下の旧 Other/ — Data/Other/ とは別物）
Other/sessions/
